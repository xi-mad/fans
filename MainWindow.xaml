<Window x:Class="FanController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="风扇温控中心"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="700" Width="1060"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. 极简顶部状态与预设栏 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <!-- 左侧：CPU / GPU 极简温度胶囊 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="风扇控制" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Border Background="#0B1120" BorderBrush="#26354D" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU" FontSize="11.5" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CpuTempText" Text="40.0°C" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CpuLoadText" Text="12%" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0B1120" BorderBrush="#26354D" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GPU" FontSize="11.5" Foreground="#A855F7" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="GpuTempText" Text="35.0°C" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="GpuLoadText" Text="5%" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AdminBadgeBorder" CornerRadius="5" Padding="8,4" Background="#065F46" Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonDown="AdminBadgeBorder_MouseLeftButtonDown">
                        <TextBlock x:Name="AdminBadgeText" Text="管理员" FontSize="11" Foreground="#34D399"/>
                    </Border>
                </StackPanel>

                <!-- 右侧：全局预设 + 一键校准 + 保存 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="静音" Style="{StaticResource ModernButtonStyle}" Padding="10,5" Margin="0,0,6,0" Click="GlobalSilentPreset_Click"/>
                    <Button Content="均衡" Style="{StaticResource ModernButtonStyle}" Padding="10,5" Margin="0,0,6,0" Click="GlobalBalancedPreset_Click"/>
                    <Button Content="性能" Style="{StaticResource ModernButtonStyle}" Padding="10,5" Margin="0,0,6,0" Click="GlobalPerformancePreset_Click"/>
                    <Button Content="BIOS自动" Style="{StaticResource ModernButtonStyle}" Padding="10,5" Margin="0,0,14,0" Click="GlobalBiosDefault_Click"/>

                    <Button x:Name="CalibrateAllBtn" Content="校准全部风扇" Style="{StaticResource ModernButtonStyle}" BorderBrush="#F59E0B" Foreground="#FBBF24" Padding="11,5" Margin="0,0,8,0" Click="CalibrateAllFans_Click" ToolTip="自动测试所有风扇的满速与最低起转阈值（请勿与其他风扇校准软件同时运行）"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5" Click="SaveConfigButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 2. 自动校准进度条横幅（仅校准时显示） ==================== -->
        <Border x:Name="CalibrationBanner" Grid.Row="1" Visibility="Collapsed" Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CalibrationStatusText" Grid.Column="0" Text="正在校准风扇..." FontSize="12.5" Foreground="#FBBF24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <ProgressBar x:Name="CalibrationProgressBar" Grid.Column="1" Height="6" Minimum="0" Maximum="100" Value="20" Foreground="#F59E0B" Background="#0B1120" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="2" Content="取消校准" Style="{StaticResource ModernButtonStyle}" Padding="10,3" FontSize="11.5" Click="CancelCalibration_Click"/>
            </Grid>
        </Border>

        <!-- ==================== 3. 主工作区 ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：简洁风扇列表 -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,0,2,10">
                        <TextBlock Text="风扇通道" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <CheckBox x:Name="HideZeroRpmCheckBox"
                                  Content="隐藏空接口"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="11.5"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsChecked="True"
                                  Checked="FilterCheckBox_Changed"
                                  Unchecked="FilterCheckBox_Changed"/>
                    </DockPanel>

                    <ListBox x:Name="FanChannelsListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="FanChannelsListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder"
                                                    Background="#141E30"
                                                    BorderBrush="#26354D"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,9"
                                                    Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#1B283E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#1E3250"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding CustomName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxWidth="195"/>
                                        <TextBlock Text="{Binding LoadStageText}" FontSize="11" Foreground="{Binding LoadStageColor}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <DockPanel Grid.Row="1" Margin="0,0,0,5">
                                        <TextBlock Text="{Binding RpmDisplayText}" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding CurrentPwm, StringFormat={}{0:F0}%}" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <ProgressBar Grid.Row="2" Height="3" Minimum="0" Maximum="100" Value="{Binding CurrentPwm}" Foreground="#38BDF8" Background="#0B1120" BorderThickness="0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧：当前选中风扇配置与曲线 -->
            <Border Grid.Column="1" x:Name="DetailPanelBorder" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1) 顶部名称与校准单通道操作 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="FanCustomNameBox"
                                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="220"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Background="{StaticResource BgInputBrush}"
                                     Foreground="#F8FAFC"
                                     BorderBrush="#334155"
                                     Padding="8,4"/>
                            <TextBlock Text="{Binding CalibrationBadgeText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CalibrateSingleBtn" Content="校准此风扇" Style="{StaticResource ModernButtonStyle}" Padding="10,4" Margin="0,0,8,0" Click="CalibrateSelectedFan_Click"/>
                            <Button Content="同步到全部" Style="{StaticResource ModernButtonStyle}" Padding="10,4" Click="CopyCurveToAll_Click" ToolTip="将此风扇的曲线参数复制到所有风扇"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 2) 控制模式与温度源选择栏 -->
                    <Border Grid.Row="1" Background="#141E30" BorderBrush="#26354D" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="智能负载温控" IsChecked="{Binding IsSmartMode}" Foreground="#F8FAFC" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,16,0" Checked="ControlMode_Changed"/>
                                <RadioButton Content="固定转速" IsChecked="{Binding IsManualMode}" Foreground="#F8FAFC" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,16,0" Checked="ControlMode_Changed"/>
                                <RadioButton Content="BIOS 自动" IsChecked="{Binding IsBiosMode}" Foreground="#F8FAFC" FontSize="12.5" VerticalAlignment="Center" Checked="ControlMode_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="温度源" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="TempSourceCombo"
                                          SelectionChanged="TempSourceCombo_SelectionChanged"
                                          Width="175"
                                          FontSize="12">
                                    <ComboBoxItem Content="CPU / GPU 最高温度"/>
                                    <ComboBoxItem Content="仅 CPU 温度"/>
                                    <ComboBoxItem Content="仅 GPU 温度"/>
                                </ComboBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 3) 动态参数调节区（根据当前模式自动切换显示，保持极简） -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <!-- A: 智能四档负载面板 -->
                        <Border Visibility="{Binding SmartPanelVisibility}" Background="#141E30" BorderBrush="#26354D" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 低负载 -->
                                <Grid Grid.Row="0" Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="低负载 (待机)" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="温度 ≤" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="2" Minimum="25" Maximum="65" Value="{Binding LowLoadTemp}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding LowLoadTemp, StringFormat={}{0:F0}°C}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="转速" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding LowLoadSpeed}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding LowLoadSpeed, StringFormat={}{0:F0}%}" Foreground="#10B981" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- 中负载 -->
                                <Grid Grid.Row="1" Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="中负载 (日常)" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="温度 =" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="2" Minimum="35" Maximum="80" Value="{Binding MedLoadTemp}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding MedLoadTemp, StringFormat={}{0:F0}°C}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="转速" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding MedLoadSpeed}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding MedLoadSpeed, StringFormat={}{0:F0}%}" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- 高负载 -->
                                <Grid Grid.Row="2" Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="高负载 (游戏)" Foreground="#F59E0B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="温度 =" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="2" Minimum="45" Maximum="90" Value="{Binding HighLoadTemp}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding HighLoadTemp, StringFormat={}{0:F0}°C}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="转速" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding HighLoadSpeed}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding HighLoadSpeed, StringFormat={}{0:F0}%}" Foreground="#F59E0B" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- 满载保护 -->
                                <Grid Grid.Row="3" Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="满载 (保护)" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="温度 ≥" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="2" Minimum="60" Maximum="100" Value="{Binding CriticalTemp}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CriticalTemp, StringFormat={}{0:F0}°C}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="4" Text="转速" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="5" Minimum="50" Maximum="100" Value="{Binding CriticalSpeed}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding CriticalSpeed, StringFormat={}{0:F0}%}" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- 防抖迟滞设置 -->
                                <DockPanel Grid.Row="4" Margin="0,4,0,0">
                                    <TextBlock Text="降温迟滞防抖" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Width="140" Minimum="0" Maximum="8" Value="{Binding HysteresisTemp}" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding HysteresisTemp, StringFormat={}{0:F1}°C}" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="(防止温度小幅波动时风扇频繁加减速)" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- B: 手动固定转速面板 -->
                        <Border Visibility="{Binding ManualPanelVisibility}" Background="#141E30" BorderBrush="#26354D" BorderThickness="1" CornerRadius="6" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="固定转速百分比" FontWeight="SemiBold" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ManualSpeedPercent}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ManualSpeedPercent, StringFormat={}{0:F0}%}" FontSize="14" FontWeight="Bold" Foreground="#A855F7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- C: BIOS 自动面板 -->
                        <Border Visibility="{Binding BiosPanelVisibility}" Background="#141E30" BorderBrush="#26354D" BorderThickness="1" CornerRadius="6" Padding="16,14">
                            <TextBlock Text="已交由主板 BIOS (Q-Fan) 或显卡默认策略自动控制。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                        </Border>
                    </Grid>

                    <!-- 4) 底部：实时温控曲线 -->
                    <Border Grid.Row="3" Background="#0B1120" BorderBrush="#26354D" BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="2,0,2,4">
                                <TextBlock Text="温控曲线" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CurrentSourceTemp, StringFormat=当前 {0:F1}°C}" FontSize="12" Foreground="#F8FAFC" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding TargetPwm, StringFormat=目标 {0:F0}%}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>

                            <Canvas x:Name="CurveCanvas"
                                    Grid.Row="1"
                                    ClipToBounds="True"
                                    Background="Transparent"
                                    SizeChanged="CurveCanvas_SizeChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 4. 极简底部栏 ==================== -->
        <DockPanel Grid.Row="3" Margin="2,10,2,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="AutoStartCheckBox"
                          Content="开机自动启动 (静默托盘)"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,0,18,0"
                          Click="AutoStartCheckBox_Click"/>

                <CheckBox x:Name="RestoreBiosOnExitCheckBox"
                          Content="退出时恢复主板 BIOS 自动控制"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="0,0,18,0"/>

                <TextBlock Text="点击关闭按钮时：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CloseBehaviorCombo" Width="125" FontSize="11.5" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="CloseBehaviorCombo_SelectionChanged">
                    <ComboBoxItem Content="每次弹窗询问"/>
                    <ComboBoxItem Content="最小化到托盘"/>
                    <ComboBoxItem Content="直接退出软件"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusFooterText" Text="就绪" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Content="最小化到托盘" Style="{StaticResource ModernButtonStyle}" Padding="10,3" FontSize="11.5" Click="MinimizeToTray_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
